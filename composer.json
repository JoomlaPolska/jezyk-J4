{
    "name": "joomla/jezyk-j4",
    "description": "Tłumaczenie Joomla!",
    "type": "project",
    "license": "GNU/GPL 2.0",
    "scripts": {
        "build": "phing",
        "clean": "phing clean",
        "test:server:start": "docker-compose up -d",
        "test:server:cleanup": "docker-compose down -v",
        "test:translation": "TranslationTest\\Command\\Verify::execute"
    },
    "scripts-descriptions": {
        "test:translation": "Test translation state against current English version."
    },
    "autoload": {
        "psr-4": {
            "TranslationTest\\":"tests/translation/"
        }
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phing/phing": "^3"
    },
    "require": {
        "ext-json": "*",
        "php": "^8.1",
        "ext-simplexml": "*",
        "ext-curl": "*"
    }
}